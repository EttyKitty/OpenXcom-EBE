root = true

[*]
; Broken in Visual Studio
;charset = utf-8
trim_trailing_whitespace = true
vc_generate_documentation_comments = doxygen_slash_star
indent_size = 2

[*.{yml,rul}]
indent_style = space

[*.{c,cpp,h,hpp}]
indent_style = tab
insert_final_newline = true
indent_size = 4

[Makefile]
indent_style = tab

[CMakeLists.txt]
indent_style = space
