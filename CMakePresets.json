{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (VS2022)",
      "description": "Primary Windows build - cmake --preset windows-x64-release (VS2022 x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "BUILD_PACKAGE": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (VS2022)",
      "description": "Debug build with Debug flags. For fastest iteration use ninja-debug-fast instead.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "ENABLE_PCH": "ON",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "windows-x64-debug-fast",
      "displayName": "Windows x64 Debug Fast (Ninja + PCH)",
      "description": "MAX SPEED debug - Ninja + PCH + LTCG off + incremental link. Use windows-x64-debug for VS generator.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "CHECK_CCACHE": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "ENABLE_PCH": "ON",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "windows-win32-release",
      "displayName": "Windows Win32 Release (VS2022)",
      "description": "32-bit Windows build - for legacy / XP compat testing",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "Ninja-based Release - Linux/macOS/Windows Ninja - with ccache if available",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "CHECK_CCACHE": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Ninja Debug - PCH on, no LTCG, sccache on (/Z7).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "CHECK_CCACHE": "ON",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "ENABLE_PCH": "OFF",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "ci-linux-release",
      "displayName": "CI Linux Release",
      "description": "CI mirror - Unix Makefiles - ccache",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DEV_BUILD": "ON",
        "CHECK_CCACHE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-debug-fast",
      "configurePreset": "windows-x64-debug-fast",
      "configuration": "Debug"
    },
    {
      "name": "windows-win32-release",
      "configurePreset": "windows-win32-release",
      "configuration": "Release"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release",
      "configuration": "Release"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "configuration": "Debug"
    },
    {
      "name": "ci-linux-release",
      "configurePreset": "ci-linux-release",
      "configuration": "Release"
    }
  ]
}
